# Variables del entorno local. Copiar a .env y ajustar si hace falta.
#
# Precedencia de configuracion: variable de entorno -> config/deployment.json ->
# valor por omision. En AWS, config/deployment.json lo genera la secuencia de
# despliegue y no debe editarse a mano (REQ-09).

# Secreto del emisor local de tokens. En AWS no se usa: alli firma Cognito.
# Debe tener al menos 32 bytes.
RASTRO_JWT_SECRETO=rastro-secreto-local-solo-para-desarrollo-32b

# Vigencia del enlace prefirmado de carga de evidencias, en segundos.
RASTRO_VIGENCIA_ENLACE=300

# Registro de eventos de datos de CloudTrail. Es el componente de costo variable
# de mayor incertidumbre del proyecto: se habilita solo despues de cuantificarlo
# con la calculadora oficial de precios.
RASTRO_EVENTOS_DE_DATOS=no

# Claves de los usuarios sinteticos que crea el despliegue en Cognito.
RASTRO_CLAVE_ANDES=Andes.Rastro.2026
RASTRO_CLAVE_SABANA=Sabana.Rastro.2026
