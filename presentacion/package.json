{
  "name": "rastro-presentacion",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Diapositivas de sustentación de Rastro y Cotejo, generadas desde documentacion/sustentacion/*.md al construir.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test \"compilador/*.test.ts\""
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
